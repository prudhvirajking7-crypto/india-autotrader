# ─────────────────────────────────────────────
# India AutoTrader — Environment Variables
# Copy to .env and fill in real values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────

# ── App ────────────────────────────────────────
APP_ENV=development          # development | staging | production
LOG_LEVEL=INFO               # DEBUG | INFO | WARNING | ERROR
PAPER_TRADING=true           # true = no real orders placed

# ── Security ───────────────────────────────────
WEBHOOK_SECRET=change_me_to_a_random_32char_string
API_SECRET_KEY=another_random_secret_for_internal_api

# ── Redis ──────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ── Active Broker ──────────────────────────────
# One of: zerodha | upstox | angelone | finvasia
ACTIVE_BROKER=zerodha

# ── Zerodha / Kite Connect ─────────────────────
ZERODHA_API_KEY=
ZERODHA_API_SECRET=
ZERODHA_ACCESS_TOKEN=        # Generated via login flow; refresh daily
ZERODHA_USER_ID=
ZERODHA_PASSWORD=
ZERODHA_TOTP_SECRET=         # Base32 TOTP secret for 2FA auto-login

# ── Upstox ─────────────────────────────────────
UPSTOX_API_KEY=
UPSTOX_API_SECRET=
UPSTOX_REDIRECT_URI=http://localhost:8000/broker/upstox/callback
UPSTOX_ACCESS_TOKEN=

# ── Angel One / SmartAPI ───────────────────────
ANGELONE_API_KEY=
ANGELONE_CLIENT_ID=
ANGELONE_PASSWORD=
ANGELONE_TOTP_SECRET=

# ── Finvasia / Shoonya ─────────────────────────
FINVASIA_USER_ID=
FINVASIA_PASSWORD=
FINVASIA_API_KEY=
FINVASIA_VENDOR_CODE=
FINVASIA_IMEI=

# ── Risk Management ────────────────────────────
MAX_CAPITAL=100000           # Total capital in INR to deploy
RISK_PER_TRADE_PCT=1.0       # % of capital to risk per trade
MAX_OPEN_POSITIONS=5         # Maximum concurrent open positions
DAILY_LOSS_LIMIT_PCT=3.0     # Stop trading when daily loss exceeds this %
MAX_POSITION_SIZE_PCT=20.0   # Max single position as % of capital

# ── Telegram Notifications ─────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=            # Your personal or group chat ID

# ── Data ───────────────────────────────────────
NSE_RATE_LIMIT_DELAY=1.0     # Seconds between NSE scraping requests

# ── TradingView ────────────────────────────────
# Whitelist TradingView IPs (comma-separated). Leave blank to skip check.
TRADINGVIEW_IP_WHITELIST=52.89.214.238,34.212.75.30,54.218.53.128,52.32.178.7
